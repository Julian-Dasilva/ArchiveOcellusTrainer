{
  "ignore": ["review-ratchet/fixtures"],
  "scripts": [
    {
      "path": "scripts/netlify-build.sh",
      "tests": ["scripts/netlify-build.test.sh"],
      "policies": [
        {
          "policy": "errexit stops the build at the first failed command",
          "mutation": [{ "find": "set -euo pipefail\n", "replace": "set -uo pipefail\n" }]
        },
        {
          "policy": "errexit is on before prepare_reader runs",
          "mutation": [
            { "find": "set -euo pipefail\n", "replace": "" },
            { "find": "\nprepare_reader\n", "replace": "\nprepare_reader\nset -euo pipefail\n" }
          ]
        }
      ]
    },
    {
      "path": "scripts/install-beta-sdk.sh",
      "tests": ["scripts/install-beta-sdk.test.sh"],
      "policies": [
        {
          "policy": "prebuilt packs from another commit are refused",
          "mutation": [{ "find": "    if [[ \"${commit}\" != \"${OSRS_SDK_COMMIT}\" ]]; then\n", "replace": "    if false; then\n" }]
        },
        {
          "policy": "a build stamps the commit it checked out into every pack",
          "mutation": [{ "find": "    npm pkg set \"gitHead=${built}\" --workspaces --include-workspace-root\n", "replace": "" }]
        },
        {
          "policy": "prebuilt packs at the pin are used",
          "mutation": [{ "find": "if [[ -n \"${OSRS_SDK_PACKS}\" ]] && packs_at_pin", "replace": "if false && packs_at_pin" }]
        },
        {
          "policy": "the check fails unless every installed package is at the pin",
          "mutation": [{ "find": "  if [[ \"${installed}\" == \"${OSRS_SDK_COMMIT}\" ]]; then\n", "replace": "  if true; then\n" }]
        },
        {
          "policy": "an unreadable installed manifest fails the check",
          "mutation": [{ "find": " 2>/dev/null || echo unreadable\n", "replace": "\n" }]
        }
      ]
    },
    {
      "path": "scripts/verify.sh",
      "tests": ["scripts/install-beta-sdk.test.sh"],
      "policies": [
        {
          "policy": "verify reinstalls unless the installed SDK is at the pin",
          "mutation": [{ "find": "  scripts/install-beta-sdk.sh --check && return 0\n", "replace": "  return 0\n" }]
        }
      ]
    },
    {
      "path": "scripts/check-types.mjs",
      "tests": ["scripts/check-types.test.sh"],
      "policies": [
        {
          "policy": "a finding fails the check",
          "mutation": [{ "find": "process.exit(findings.length === 0 ? 0 : 1);", "replace": "process.exit(0);" }]
        },
        {
          "policy": "a src/sim file that imports from outside src/sim is a finding",
          "mutation": [{ "find": "      if (insideSim && target && !target.startsWith(SIM + path.sep)) {\n", "replace": "      if (false) {\n" }]
        },
        {
          "policy": "a src/sim core file that imports an osrs-sdk package is a finding",
          "mutation": [{ "find": "      if (insideSimCore && SDK_PACKAGE.test(node.text)) {\n", "replace": "      if (false) {\n" }]
        },
        {
          "policy": "a src/sim core file that imports src/sim/sdk is a finding",
          "mutation": [{ "find": "      if (insideSimCore && target && target.startsWith(SIM_SDK + path.sep)) {\n", "replace": "      if (false) {\n" }]
        },
        {
          "policy": "a src/sim file that imports React is a finding",
          "mutation": [{ "find": "      if (insideSim && REACT_PACKAGE.test(node.text)) {\n", "replace": "      if (false) {\n" }]
        },
        {
          "policy": "a page file that imports the fight engine is a finding",
          "mutation": [{ "find": "      if (engineEntry && !insideSim && !file.startsWith(OCELUS + path.sep)) {\n", "replace": "      if (false) {\n" }]
        }
      ]
    },
    {
      "path": "scripts/release-notes.mjs",
      "tests": ["scripts/release-notes.test.sh"],
      "policies": [
        {
          "policy": "a newest version that is not YYYY.MM.DD or YYYY.MM.DD.N fails",
          "mutation": [{ "find": "!VERSION.test(newest.version)", "replace": "false" }]
        },
        {
          "policy": "a newest version that repeats an earlier release fails",
          "mutation": [{ "find": ": earlier.some((release) => release.version === newest.version)", "replace": ": false" }]
        },
        {
          "policy": "the notes are the first release in the changelog",
          "mutation": [{ "find": "const [newest, ...earlier] = CHANGELOG;", "replace": "const [newest, ...earlier] = [...CHANGELOG].reverse();" }]
        },
        {
          "policy": "each note prints as a Markdown list item under the version heading",
          "mutation": [{ "find": "`- ${note}`", "replace": "`* ${note}`" }]
        },
        {
          "policy": "notes since a version leave that version out",
          "mutation": [{ "find": "  return false;\n}", "replace": "  return true;\n}" }]
        },
        {
          "policy": "a shipped release whose notes changed fails",
          "mutation": [{ "find": "if (notesDigest(release) !== digest) return", "replace": "if (false) return" }]
        },
        {
          "policy": "a shipped release missing from the changelog while an older one is listed fails",
          "mutation": [{ "find": "if (release === undefined) return isAfter(oldest.version, version) ? null : `${version} shipped but is missing from the changelog`;", "replace": "if (release === undefined) return null;" }]
        },
        {
          "policy": "a changelog that is not newest first fails",
          "mutation": [{ "find": "index > 0 && !isAfter(CHANGELOG[index - 1].version, release.version)", "replace": "false" }]
        },
        {
          "policy": "a shipped release older than every release in the changelog may be dropped",
          "mutation": [{ "find": "return isAfter(oldest.version, version) ? null : `${version}", "replace": "return `${version}" }]
        },
        {
          "policy": "recording keeps the earlier shipped releases",
          "mutation": [{ "find": ", ...shipped };", "replace": " };" }]
        },
        {
          "policy": "recording covers every release the same arguments publish",
          "mutation": [{ "find": "Object.fromEntries(published.map(", "replace": "Object.fromEntries([newest].map(" }]
        },
        {
          "policy": "recording prints the notes it records",
          "mutation": [{ "find": "  fs.writeFileSync(shippedFile, `${JSON.stringify(recorded, null, 2)}\\n`);\n}\nprocess.stdout.write(", "replace": "  fs.writeFileSync(shippedFile, `${JSON.stringify(recorded, null, 2)}\\n`);\n} else process.stdout.write(" }]
        }
      ]
    },
    {
      "path": "scripts/release-build.sh",
      "tests": ["scripts/release-build.test.sh"],
      "policies": [
        {
          "policy": "a set analytics token refuses the release build",
          "mutation": [{ "find": "if [[ -n \"${CF_WEB_ANALYTICS_TOKEN:-}\" ]]; then\n  echo \"release-build: CF_WEB_ANALYTICS_TOKEN is set, so this build would ship the analytics beacon\" >&2\n  exit 1\nfi\n", "replace": "" }]
        }
      ]
    },
    {
      "path": "review-ratchet/checks/shell-test-runs-entry.mjs",
      "tests": ["review-ratchet/checks/shell-test-runs-entry.test.sh"],
      "policies": [
        {
          "policy": "a test that passes under a mutation is a finding",
          "mutation": [{ "find": "        findings.push(`${test}: passes when", "replace": "        undecided.push(`${test}: passes when" }]
        },
        {
          "policy": "every shell test outside the ignored directories is listed",
          "mutation": [{ "find": "!ignored(file) && !listed.has(file)", "replace": "!ignored(file) && !listed.has(file) && false" }]
        },
        {
          "policy": "a failing case counts as catching a mutation only with an ASSERTION FAILED line in its output",
          "mutation": [{ "find": "result: behaviour.some((line) => ASSERTION_FAILED.test(line)) ? \"asserted\" : \"errored\"", "replace": "result: \"asserted\"" }]
        },
        {
          "policy": "a failing case counts only when it prints its ready line under the mutation",
          "mutation": [{ "find": "const behaviour = ready === -1 ? [] : own.slice(ready + 1);", "replace": "const behaviour = own.slice(ready + 1);" }]
        },
        {
          "policy": "an ASSERTION FAILED line counts only after its case's ready line",
          "mutation": [{ "find": "const behaviour = ready === -1 ? [] : own.slice(ready + 1);", "replace": "const behaviour = ready === -1 ? [] : own;" }]
        },
        {
          "policy": "a ready line counts only when it names its case",
          "mutation": [{ "find": "line.trim() === `ready ${name}`", "replace": "line.trim().startsWith(\"ready \")" }]
        },
        {
          "policy": "a failing case counts only when it also prints its ready line before any mutation",
          "mutation": [{ "find": "found.result === \"passed\" && found.ready ?", "replace": "found.result === \"passed\" ?" }]
        },
        {
          "policy": "an ASSERTION FAILED line counts only for the case whose output holds it",
          "mutation": [{ "find": "const own = lines.slice(start + 1, starts[index + 1]);", "replace": "const own = lines;" }]
        },
        {
          "policy": "an indented ASSERTION FAILED line counts",
          "mutation": [{ "find": "const ASSERTION_FAILED = /^[ \\t]*ASSERTION FAILED: /;", "replace": "const ASSERTION_FAILED = /^ASSERTION FAILED: /;" }]
        },
        {
          "policy": "a mutant run that reports other cases than the test as it is does not count as catching the mutation",
          "mutation": [{ "find": "if (names(outcome.cases) !== names(control)) {", "replace": "if (false) {" }]
        },
        {
          "policy": "a test with a failing case before any mutation is refused",
          "mutation": [{ "find": "if (failing.length === 0) controls.set", "replace": "if (true) controls.set" }]
        },
        {
          "policy": "a mutant that fails its syntax check is refused",
          "mutation": [{ "find": "if (invalid !== null) throw new Error(invalid);", "replace": "" }]
        },
        {
          "policy": "a TypeScript mutant must parse with esbuild, the parser tsx runs it with",
          "mutation": [{ "find": "\".ts\": [fileURLToPath(new URL(\"../../node_modules/.bin/esbuild\", import.meta.url))]", "replace": "\".ts\": [process.execPath, \"--experimental-strip-types\", \"--check\"]" }]
        }
      ]
    },
    {
      "path": "review-ratchet/checks/replay-controls.mjs",
      "tests": ["review-ratchet/checks/replay-controls.test.sh"],
      "policies": [
        {
          "policy": "an acknowledged control that fails after the overlay is not broken",
          "mutation": [{ "find": "} else if (acknowledgement && after?.status === \"fail\" && !after.fileFailed) {", "replace": "} else if (false) {" }]
        },
        {
          "policy": "an acknowledged control that passes after the overlay is stale",
          "mutation": [{ "find": "if (acknowledgement) passing.push(", "replace": "if (false) passing.push(" }]
        },
        {
          "policy": "an acknowledgement that names no control of a replayed file is stale",
          "mutation": [{ "find": "[...acknowledged].filter(([test]) => !judged.has(test))", "replace": "[...acknowledged].filter(() => false)" }]
        },
        {
          "policy": "an acknowledged control with no failed result after the overlay is broken",
          "mutation": [{ "find": "acknowledgement && after?.status === \"fail\" && ", "replace": "acknowledgement && " }]
        },
        {
          "policy": "an acknowledged control in a file with an error outside its tests is broken",
          "mutation": [{ "find": " && !after.fileFailed) {", "replace": ") {" }]
        },
        {
          "policy": "only acknowledgements the head adds apply",
          "mutation": [{ "find": ".filter(({ test, reason }) => !inherited.has(JSON.stringify([test, reason])))", "replace": ".filter(() => true)" }]
        },
        {
          "policy": "a malformed acknowledgement file stops the check",
          "mutation": [{ "find": "if (!Array.isArray(entries) || !entries.every(valid))", "replace": "if (false)" }]
        },
        {
          "policy": "an acknowledgement that more than one test's name matches is refused",
          "mutation": [{ "find": "const ambiguous = outcome.ambiguous || after?.ambiguous === true;", "replace": "const ambiguous = false;" }]
        },
        {
          "policy": "a file error is decided from Vitest's raw message, not its first line",
          "mutation": [{ "find": "const fileFailed = (file.message ?? \"\") !== \"\";", "replace": "const fileFailed = (file.message ?? \"\").split(\"\\n\")[0] !== \"\";" }]
        }
      ]
    },
    {
      "path": "scripts/verify/judge.mjs",
      "tests": ["scripts/verify/verdicts.test.sh"],
      "policies": [
        {
          "policy": "a drive that exited non-zero aborts its unit",
          "mutation": [{ "find": "  if (driveStatus !== \"0\") return { outcome: \"aborted\", cause: \"drive\", detail: logged() };\n", "replace": "" }]
        },
        {
          "policy": "a unit missing a capture aborts before its checks run",
          "mutation": [{ "find": "  if (missing.length > 0) return { outcome: \"aborted\", cause: \"captures\", detail: missing };\n", "replace": "" }]
        },
        {
          "policy": "a unit with a failing check fails and names it",
          "mutation": [{ "find": "return failed.length === 0 ?", "replace": "return true ?" }]
        },
        {
          "policy": "a recorded page error fails its unit",
          "mutation": [{ "find": "...(Object.keys(pageErrors).length > 0 ? [\"noPageErrors\"] : [])", "replace": "...[]" }]
        },
        {
          "policy": "a page-errors capture that is not a list counts as a page error",
          "mutation": [{ "find": "!Array.isArray(errors) || errors.length > 0", "replace": "errors.length > 0" }]
        },
        {
          "policy": "judge exits non-zero unless the unit passed",
          "mutation": [{ "find": "process.exit(verdict.outcome === \"passed\" ? 0 : 1);", "replace": "process.exit(0);" }]
        }
      ]
    },
    {
      "path": "scripts/verify/report.mjs",
      "tests": ["scripts/verify/verdicts.test.sh"],
      "policies": [
        {
          "policy": "a selected unit without a verdict fails the browser stage",
          "mutation": [
            { "find": "const verdicts = selected.map(verdictOf);", "replace": "const verdicts = selected.map(verdictOf).filter(({ outcome }) => outcome !== \"missing\");" }
          ]
        },
        {
          "policy": "a cross-unit check is judged only once every unit it reads completed",
          "mutation": [{ "find": "const absent = units.filter((unit) => !completed.has(unit));", "replace": "const absent = [];" }]
        },
        {
          "policy": "a failing cross-unit check fails the browser stage",
          "mutation": [{ "find": "failedChecks.length === 0 ? 0 : 1", "replace": "true ? 0 : 1" }]
        }
      ]
    },
    {
      "path": "scripts/verify.sh",
      "tests": ["scripts/verify/bundle.test.sh"],
      "policies": [
        {
          "policy": "the bundle stage runs the asset bundle guard",
          "mutation": [{ "find": "node_modules/.bin/tsx src/assetBundle/check.ts", "replace": "true" }]
        }
      ]
    },
    {
      "path": "src/assetBundle/check.ts",
      "tests": ["scripts/verify/bundle.test.sh"],
      "policies": [
        {
          "policy": "every configured npc needs a non-empty payload file",
          "mutation": [{ "find": "([key, file]) => fileGaps(outDir, file)", "replace": "([key, file]) => (key.startsWith(\"npc-\") ? [] : fileGaps(outDir, file))" }]
        },
        {
          "policy": "every configured model needs a non-empty payload file",
          "mutation": [{ "find": "([key, file]) => fileGaps(outDir, file)", "replace": "([key, file]) => (key.startsWith(\"model-\") ? [] : fileGaps(outDir, file))" }]
        },
        {
          "policy": "every configured item needs a non-empty payload file",
          "mutation": [{ "find": "([key, file]) => fileGaps(outDir, file)", "replace": "([key, file]) => (key.startsWith(\"player-item-\") ? [] : fileGaps(outDir, file))" }]
        },
        {
          "policy": "every configured spot animation needs a non-empty payload file",
          "mutation": [{ "find": "([key, file]) => fileGaps(outDir, file)", "replace": "([key, file]) => (key.startsWith(\"spotanim-\") ? [] : fileGaps(outDir, file))" }]
        },
        {
          "policy": "an empty payload file counts as missing",
          "mutation": [{ "find": "found.size === 0 ?", "replace": "found.size < 0 ?" }]
        },
        {
          "policy": "a payload path that is not a regular file counts as missing",
          "mutation": [{ "find": "if (!found.isFile()) return [`${file} is not a file`];\n", "replace": "" }]
        }
      ]
    },
    {
      "path": "scripts/verify/parity.mjs",
      "tests": ["scripts/verify/parity.test.sh"],
      "policies": [
        {
          "policy": "a seeded fight that differs fails unless the expectations name it",
          "mutation": [{ "find": "if (expected[name]?.head === sha)", "replace": "if (true)" }]
        },
        {
          "policy": "an expectation accepts only the head sha256 it names",
          "mutation": [{ "find": "if (expected[name]?.head === sha)", "replace": "if (expected[name] !== undefined)" }]
        },
        {
          "policy": "an expectation without a reason is refused",
          "mutation": [{ "find": "if (typeof entry.why !== \"string\" || entry.why.trim() === \"\") throw", "replace": "if (false) throw" }]
        },
        {
          "policy": "a seeded fight missing at the head differs",
          "mutation": [{ "find": "const names = [...new Set([...Object.keys(base), ...Object.keys(head)])];", "replace": "const names = Object.keys(head);" }]
        },
        {
          "policy": "each differing fight is printed with its first differing value",
          "mutation": [{ "find": "firstDifference(base[name], head[name], name)}", "replace": "name}" }]
        }
      ]
    },
    {
      "path": "scripts/verify/shard.mjs",
      "tests": ["scripts/verify/t2.test.sh"],
      "policies": [
        {
          "policy": "each unit goes to the shard with the least time so far",
          "mutation": [{ "find": "const lightest = load.reduce((best, shard) => (shard.seconds < best.seconds ? shard : best));", "replace": "const lightest = load[0];" }]
        },
        {
          "policy": "a shard prints only its own units",
          "mutation": [{ "find": "for (const unit of units.filter((unit) => load[at - 1].units.has(unit))) console.log(unit);", "replace": "for (const unit of units) console.log(unit);" }]
        }
      ]
    },
    {
      "path": "scripts/verify/t2-summary.mjs",
      "tests": ["scripts/verify/t2.test.sh"],
      "policies": [
        {
          "policy": "a browser unit that did not pass, or never reported, fails T2",
          "mutation": [{ "find": "const failedUnits = units.filter(([, { outcome }]) => outcome !== \"passed\");", "replace": "const failedUnits = [];" }]
        },
        {
          "policy": "a stage that did not pass fails T2",
          "mutation": [{ "find": "verdict.production === \"PASS\" && verdict.perf === \"PASS\"", "replace": "verdict.production === \"PASS\"" }]
        },
        {
          "policy": "timing pairs the plan selected must pass",
          "mutation": [{ "find": "(verdict.perfTiming === \"PASS\" || !timingSelected)", "replace": "true" }]
        },
        {
          "policy": "every asset the head deletes is listed",
          "mutation": [{ "find": "verdict.assets.deleted.map((key) => `  - deleted ${key}`)", "replace": "[]" }]
        }
      ]
    },
    {
      "path": "test/workerCap.mjs",
      "tests": ["scripts/verify/workers.test.sh"],
      "policies": [
        {
          "policy": "CI uses the runner's default worker count",
          "mutation": [{ "find": "  if (env.CI) return { kind: \"runner\" };\n", "replace": "  if (false) return { kind: \"runner\" };\n" }]
        },
        {
          "policy": "a local run caps workers at 2",
          "mutation": [{ "find": "?? \"2\"", "replace": "?? \"8\"" }]
        }
      ]
    },
    {
      "path": "scripts/verify/affected-tests.mjs",
      "tests": ["scripts/verify/affected-tests.test.sh"],
      "policies": [
        {
          "policy": "a test runner file runs the whole suite",
          "mutation": [{ "find": "  if (unique.some((file) => GLOBALS.has(file))) return { kind: \"all\", reason: \"a test runner file changed, so the suite runs\" };\n", "replace": "  if (false) return { kind: \"all\", reason: \"a test runner file changed, so the suite runs\" };\n" }]
        },
        {
          "policy": "a diff with no source file runs no unit test",
          "mutation": [{ "find": "  if (!unique.some((file) => SOURCE.test(file))) return { kind: \"none\", reason: \"no source file changed, so no unit test runs\" };\n", "replace": "  if (false) return { kind: \"none\", reason: \"no source file changed, so no unit test runs\" };\n" }]
        },
        {
          "policy": "a source file runs the tests that import it",
          "mutation": [{ "find": "kind: \"related\"", "replace": "kind: \"none\"" }]
        }
      ]
    },
    {
      "path": "scripts/verify/pr-evidence.mjs",
      "tests": ["scripts/verify/pr-evidence.test.sh"],
      "policies": [
        {
          "policy": "a pull request without a Verification section fails",
          "mutation": [{ "find": "  if (section === null) return [\"the pull request has no ## Verification section\"];\n", "replace": "  if (false) return [\"the pull request has no ## Verification section\"];\n" }]
        },
        {
          "policy": "the Verification section names a scripts/verify.sh command",
          "mutation": [{ "find": "  if (!section.includes(\"scripts/verify.sh\")) missing.push(\"the Verification section does not name a scripts/verify.sh command\");\n", "replace": "  if (false) missing.push(\"the Verification section does not name a scripts/verify.sh command\");\n" }]
        },
        {
          "policy": "the Verification section records a PASS line or an Actions run",
          "mutation": [{ "find": "  if (!/\\bPASS\\b|actions\\/runs\\/\\d+/.test(section)) missing.push(\"the Verification section does not record a PASS line or a GitHub Actions run\");\n", "replace": "  if (false) missing.push(\"the Verification section does not record a PASS line or a GitHub Actions run\");\n" }]
        },
        {
          "policy": "a change that selects every unit names CI",
          "mutation": [{ "find": "  if (plan.tier === \"t2\" && !/\\bCI\\b|actions\\/runs\\/\\d+/.test(section)) missing.push(\"this change selects every unit, so the Verification section must name CI\");\n", "replace": "  if (false) missing.push(\"this change selects every unit, so the Verification section must name CI\");\n" }]
        },
        {
          "policy": "timing pairs report a frame time, a tick gap, or draw calls",
          "mutation": [{ "find": "  if (plan.tier === \"t1\" && plan.units.includes(\"perf_timing\") && !/frame|draw call|tick-gap|tick gap/i.test(section)) {\n", "replace": "  if (false) {\n" }]
        }
      ]
    },
    {
      "path": "scripts/verify.sh",
      "tests": ["scripts/verify/chrome.test.sh"],
      "policies": [
        {
          "policy": "a browser that does not open fails the launch check",
          "mutation": [{ "find": "    log \"chrome: did not launch: ${line}\"\n    return 1\n", "replace": "    log \"chrome: did not launch: ${line}\"\n    return 0\n" }]
        }
      ]
    },
    {
      "path": "scripts/verify/ci-verdict.mjs",
      "tests": ["scripts/verify/ci-verdict.test.sh"],
      "policies": [
        {
          "policy": "no test workflow run is not a pass",
          "mutation": [{ "find": "if (!Array.isArray(runs) || runs.length === 0) return { code: 2, text:", "replace": "if (!Array.isArray(runs) || runs.length === 0) return { code: 0, text:" }]
        },
        {
          "policy": "a run that is still going is not a verdict",
          "mutation": [{ "find": "if (run.status !== \"completed\") return { code: 2, text:", "replace": "if (run.status !== \"completed\") return { code: 0, text:" }]
        },
        {
          "policy": "a finished run with no t2-verdict artifact is not a pass",
          "mutation": [{ "find": "if (verdict === null) return { code: 2, text:", "replace": "if (verdict === null) return { code: 0, text:" }]
        },
        {
          "policy": "a failed T2 verdict fails the command",
          "mutation": [{ "find": "code: verdict.passed === true ? 0 : 1", "replace": "code: 0" }]
        }
      ]
    },
    {
      "path": "scripts/verify/parity-harness.sh",
      "tests": ["scripts/verify/parity-harness.test.sh"],
      "policies": [
        {
          "policy": "the base tree gets the worker cap the head parity config imports",
          "mutation": [{ "find": "  cp test/workerCap.mjs \"$src/test/workerCap.mjs\"\n", "replace": "  true\n" }]
        }
      ]
    },
    {
      "path": "scripts/verify.sh",
      "tests": ["scripts/verify/parity-harness.test.sh"],
      "policies": [
        {
          "policy": "the parity base tree is built by the harness installer",
          "mutation": [{ "find": "install_parity_harness \"$src\"", "replace": "cp -R test/parity \"$src/test/\"" }]
        }
      ]
    }
  ]
}
